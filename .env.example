# HuggingFace token (required for SAM3 and DINOv3 inference)
HF_TOKEN=hf_token

# Root directory for dataset images & annotations (defaults to ./data)
ZERO_SHOT_DATA_DIR=./data

# Model cache directory (defaults to ./models-cache if unset)
MODEL_CACHE_DIR=./models-cache

# Local directory containing the EUPE checkpoint (only needed for eupe_vitb16 embeddings) in binary classification training/inference
EUPE_REPO_DIR=./EUPE